# Provider
DEICIDE_PROVIDER=nvidia
DEICIDE_MODEL=minimaxai/minimax-m3.1-flash

# NVIDIA
NVIDIA_API_KEY=SUA_CHAVE_NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Alternative API key
DEICIDE_API_KEY=

# Execution Budget
DEICIDE_MAX_REQUESTS=3
DEICIDE_MAX_TOKENS=8000

# Quota Management
DEICIDE_QUOTA_ENABLED=true
DEICIDE_QUOTA_SCOPE=nvidia

# Security
DEICIDE_ALLOW_EXTERNAL_CODE=0

# Network
DEICIDE_TIMEOUT_SECONDS=120
DEICIDE_MAX_RETRIES=0