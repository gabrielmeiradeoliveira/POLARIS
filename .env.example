POSTGRES_DB=polaris
POSTGRES_USER=polaris
POSTGRES_PASSWORD=change-me-before-starting
POLARIS_REPOSITORIES_PATH=/absolute/path/to/read-only-repositories
# NVIDIA remains disabled. Do not put NVIDIA_API_KEY in this file.

# GitHub App (leave unset to keep GitHub integration inactive).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
# GITHUB_WEBHOOK_SECRET=
# Local development / isolated staging only. Never expose this to the frontend.
# POLARIS_ADMIN_TOKEN=
# Local development only. Never put this token in frontend variables.
# POLARIS_GITHUB_TOKEN=
# GitHub checkout runs in the worker's 512 MiB noexec tmpfs. Increase only after
# setting an equivalent hard filesystem/volume quota in the deployment runtime.
