FROM node:22-alpine AS web-build
WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY --from=web-build /app/web/dist ./web/dist
RUN pip install --no-cache-dir .

ENV PYTHONPATH=/app/src
EXPOSE 8000
CMD ["uvicorn", "polaris_server.api:app", "--host", "0.0.0.0", "--port", "8000", "--limit-concurrency", "10"]
