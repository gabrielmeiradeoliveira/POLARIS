FROM python:3.12-slim

WORKDIR /app
RUN addgroup --system polaris && adduser --system --ingroup polaris polaris

RUN pip install --no-cache-dir fastapi==0.163.1 uvicorn==0.54.0 "psycopg[binary]==3.2.3"

COPY src/ /app/src/
ENV PYTHONPATH=/app/src

USER polaris
EXPOSE 8000
CMD ["uvicorn", "polaris_server.api:app", "--host", "0.0.0.0", "--port", "8000"]
